# ============================================================
# GTT 合作方登录配置（doc/GTT_PARTNER_AUTH.md）
# 本文件含密钥，请勿提交到代码仓库
# ============================================================

# 是否启用登录保护：0 = 关闭（接口与页面裸奔，仅本地调试用）
PARTNER_AUTH_ENABLED=1

# 登录模式：mock = 本地演示账号 · upstream = 对接 airU 正式登录服务
# 注意：同名变量以文件中"第一次出现"的为准，请勿重复定义
PARTNER_AUTH_MODE=upstream
#PARTNER_AUTH_MODE=mock

# 合作方标识（由 airU 分配）
PARTNER_AUTH_CLIENT_ID=gtt-sales

# 会话 Cookie 签名密钥：生产必须替换为 ≥32 字节随机串
PARTNER_AUTH_SECRET=local-dev-secret-change-me-before-production

# 会话有效期（秒），与 airU Token TTL 保持一致
PARTNER_AUTH_TOKEN_TTL_SECONDS=28800

# airU 登录服务地址（切换到 mock 模式时无需改动，留空即可）
PARTNER_AUTH_UPSTREAM_BASE=https://test.ysssss.online:4002

# HTTPS 环境务必开启 Secure
# PARTNER_AUTH_COOKIE_SECURE=1
