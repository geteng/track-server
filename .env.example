# ============================================================
# GTT 合作方登录配置示例（复制为 .env 后按需修改）
# 详见 doc/GTT_PARTNER_AUTH.md
# ============================================================

# 是否启用登录保护：1 启用（默认）· 0 关闭（接口与页面不校验，仅本地调试）
PARTNER_AUTH_ENABLED=1

# mock 本地演示账号（不依赖外网） · upstream 对接 airU 登录服务
PARTNER_AUTH_MODE=mock

# 合作方标识（由 airU 分配，文档中为 gtt-sales）
PARTNER_AUTH_CLIENT_ID=gtt-sales

# 会话 Cookie 签名密钥：生产必须替换为 ≥32 字节随机串，不得提供给 GTT
PARTNER_AUTH_SECRET=

# 会话有效期（秒）
PARTNER_AUTH_TOKEN_TTL_SECONDS=28800

# 正式环境（upstream 模式）需要：
# PARTNER_AUTH_MODE=upstream
# PARTNER_AUTH_UPSTREAM_BASE=https://test.ysssss.online:4002
# PARTNER_AUTH_COOKIE_SECURE=1
# CORS_ALLOWED_ORIGINS=<保留现有来源并追加https://gtt666.cn>
